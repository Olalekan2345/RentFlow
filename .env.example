# ─────────────────────────────────────────────────────────────────────────────
# RentFlow environment. Copy to `.env` and fill in your Hedera testnet values.
# Never commit `.env`. Get a free testnet account + faucet HBAR at portal.hedera.com
# ─────────────────────────────────────────────────────────────────────────────

# ── LANDLORD (the x402 paywall / receipt signer) ────────────────────────────
# The landlord's Hedera testnet account — receives rent, signs receipts.
HEDERA_LANDLORD_ID=0.0.xxxxxx
HEDERA_LANDLORD_KEY=302e0201...        # DER-encoded ED25519 private key

# ── TENANT AGENT (the autonomous payer) ─────────────────────────────────────
# The agent's own Hedera testnet account — funds are drawn from here.
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=302e0201...        # DER-encoded ED25519 private key

# ── NETWORK ─────────────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ── ASSET ───────────────────────────────────────────────────────────────────
# Leave USDC_TOKEN_ID blank to settle in HBAR (tinybar pricing).
# If set, RentFlow settles in the HTS token and auto-associates it first.
USDC_TOKEN_ID=

# ── LEASE / DEMO ────────────────────────────────────────────────────────────
LEASE_ID=lease-lagos-001
# Daily rent. In HBAR mode this is HBAR; in USDC mode it is token units.
DAILY_RATE_HBAR=1
DAILY_RATE_USDC=5
LEASE_TERM_DAYS=30
GRACE_PERIOD_DAYS=3

# Demo pacing: seconds between each day's settlement (fixed cadence). 15 is a
# comfortable pace to narrate; lower it (e.g. 5) to fit a full month in less time.
TIME_ACCELERATION_SECONDS=15

# Budget guardian: alert when runway (days of rent covered) drops below this.
LOW_BALANCE_THRESHOLD_DAYS=5

# ── SERVERS ─────────────────────────────────────────────────────────────────
LANDLORD_PORT=4021
AGENT_PORT=4022
# The dashboard reads these:
NEXT_PUBLIC_AGENT_URL=http://localhost:4022
NEXT_PUBLIC_LANDLORD_URL=http://localhost:4021

# ── CLAUDE WEEKLY REPORT (optional differentiator) ──────────────────────────
# Leave blank to disable; the core x402 flow runs without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OPTIONAL WEBHOOK for budget alerts ──────────────────────────────────────
ALERT_WEBHOOK_URL=
